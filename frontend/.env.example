# Copy to .env for local dev. Vite only exposes vars prefixed with VITE_.
# Get a key at https://auth.mappls.com/console (Mappls = MapmyIndia).
# Whitelist http://localhost:5173 in the Mappls console for local dev.
VITE_MAPPLS_KEY=your_mappls_key_here

# Voice assistant brain (optional). Leave every value empty to use the offline
# canned answers, which need no key. A local llama.cpp server works too - point
# the URL at http://127.0.0.1:8080/v1/chat/completions and leave KEY empty (see
# docs/frontend/voice-stack.md, "Local brain"). In production
# VITE_VOICE_CHAT_URL must point at a Vercel function so the key is not inlined
# into the JS bundle.
VITE_VOICE_CHAT_URL=
VITE_VOICE_CHAT_KEY=
VITE_VOICE_CHAT_MODEL=

# Speech models (optional). With no URL the browser downloads and runs the
# model itself, so audio never leaves the device and no key is needed. Set a
# URL when the model runs on a GPU elsewhere - self-hosted or hosted. The
# client speaks the OpenAI audio shapes (/v1/audio/transcriptions,
# /v1/audio/speech), so a vendor with its own shape needs a serverless adapter
# in front of it (see docs/frontend/voice-stack.md, "Production topology").
# Keys are inlined into the bundle like the chat key above.
VITE_VOICE_STT_URL=
VITE_VOICE_STT_KEY=
VITE_VOICE_STT_MODEL=
# Browser-only: which backend the local Whisper uses, wasm (default) or webgpu.
VITE_VOICE_STT_DEVICE=
VITE_VOICE_TTS_URL=
VITE_VOICE_TTS_KEY=
VITE_VOICE_TTS_MODEL=
# Voice id for the remote endpoint; empty falls back to the language's voice.
VITE_VOICE_TTS_VOICE=
