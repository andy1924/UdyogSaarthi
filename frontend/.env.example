# Copy to .env for local dev. Vite only exposes vars prefixed with VITE_.
# Get a key at https://auth.mappls.com/console (Mappls = MapmyIndia).
# Whitelist http://localhost:5173 in the Mappls console for local dev.
VITE_MAPPLS_KEY=your_mappls_key_here

# Voice assistant brain (optional). Leave every value empty to use the offline
# canned answers, which need no key. A local llama.cpp server works too - point
# the URL at http://127.0.0.1:8080/v1/chat/completions and leave KEY empty (see
# docs/frontend/voice-stack.md, "Local brain"). In production
# VITE_VOICE_CHAT_URL must point at a Vercel function so the key is not inlined
# into the JS bundle.
# A request carries the recognised question and a trimmed copy of the visible
# page text (4000 characters); the recording and the spoken reply never leave
# the browser. Empty URL = offline answers = nothing leaves at all.
VITE_VOICE_CHAT_URL=
VITE_VOICE_CHAT_KEY=
VITE_VOICE_CHAT_MODEL=

# Speech models. Recognition and synthesis are local only: the browser downloads
# and runs Whisper and Kokoro/MMS itself, so no audio ever leaves the device and
# there is no URL or key to set. Do not add VITE_VOICE_STT_URL or
# VITE_VOICE_TTS_URL - the client no longer reads one (see
# docs/frontend/voice-stack.md, "Hard constraints").
# Browser-only: which backend the local Whisper uses, wasm (default) or webgpu.
VITE_VOICE_STT_DEVICE=
